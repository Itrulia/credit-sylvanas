{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "credit-sylvanas",
  "account_id": "32006b4321f1adae9bd7099cdf135350",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // www 301s to the apex in src/server/www-redirect.ts
  "routes": [
    { "pattern": "credit-sylvanas.app", "custom_domain": true },
    { "pattern": "www.credit-sylvanas.app", "custom_domain": true },
  ],
  "vars": { "CF_ZONE_ID": "1470133806d42c3c2c019ffc63d13ad0" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "credit-sylvanas-prices",
      // production database, created once with `wrangler d1 create credit-sylvanas-prices`
      "database_id": "db2c7a62-868b-49d1-b828-5fc4af6b7de5",
      "migrations_dir": "migrations",
    },
  ],
  // private raw-CSV archive: no public access, no r2.dev URL
  "r2_buckets": [
    { "binding": "ARCHIVE", "bucket_name": "credit-sylvanas-tsm-archive" },
  ],
  // must match REGION_CRON and REALM_CRON in src/server/ingest/jobs.ts character for character
  "triggers": { "crons": ["30 19 * * *", "15 */3 * * *"] },
}
